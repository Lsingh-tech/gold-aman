# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored and will NOT be committed.

# From elite.finviz.com -> Screener -> "export" URL, copy the auth= value
FINVIZ_AUTH_TOKEN=your_finviz_elite_auth_token

# From @BotFather on Telegram (looks like 123456789:AA...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Your Telegram chat id (message @userinfobot to get it)
TELEGRAM_CHAT_ID=your_chat_id
