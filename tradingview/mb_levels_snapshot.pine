//@version=6
// MB watchlist levels - SNAPSHOT from Drive "MB watchlist" updated 2026-11-05 13:30 UK,
// plus NQ / gold levels from "MB 2026-11-05 PM" and Nikkei from the 2026-11-05 close.
// Values are copied exactly from the brief, so they match the Pushover alerts.
// For levels that recalculate themselves daily, use mb_levels_auto.pine instead.
indicator("MB Levels 2026-11-05", overlay = true, max_lines_count = 100, max_labels_count = 100)

G = color.new(#16a34a, 0)
R = color.new(#dc2626, 0)
B = color.new(#2563eb, 0)
O = color.new(#d97706, 0)

var line[]  lines  = array.new<line>()
var label[] labels = array.new<label>()

lvl(float p, string txt, color c, string st) =>
    array.push(lines, line.new(bar_index - 1, p, bar_index, p, extend = extend.both, color = c, style = st, width = 2))
    array.push(labels, label.new(bar_index + 3, p, txt + "  " + str.tostring(p, format.mintick), style = label.style_label_left, color = color.new(c, 85), textcolor = c, size = size.small))

var table info = table.new(position.top_right, 1, 2, bgcolor = color.new(color.black, 20), border_width = 1)

if barstate.islast
    for l in lines
        line.delete(l)
    for b in labels
        label.delete(b)
    array.clear(lines)
    array.clear(labels)

    t = syminfo.ticker
    bias = "Not on the MB watchlist"
    plan = ""
    S = line.style_solid
    D = line.style_dashed

    if t == "NQ1!" or t == "MNQ1!"
        bias := "NQ BEARISH (RSI 36)"
        plan := "Hold 28,168 + back above 28,668 -> 29,541. Close below 28,168 -> 27,616."
