        bias := "BEARISH - avoid longs"
        plan := "Below 20d & 50d. Short only failed bounces at the 20d."

    bc = str.contains(bias, "WEAKENING") ? O : str.contains(bias, "BULL") or str.contains(bias, "STRONG") or str.contains(bias, "BUILDING") ? G : str.contains(bias, "BEAR") ? R : color.gray
